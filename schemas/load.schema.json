{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ConnectorLoadInfo": {
      "description": "The child connector part of a `rocky load --connector` result.",
      "properties": {
        "adopted_expired_claim": {
          "description": "True when this run took over an expired in-flight claim. A prior run may then have promoted its batch before it crashed, and this run may load a duplicate batch.",
          "type": "boolean"
        },
        "attempts": {
          "description": "Attempts that ran, counting the successful one. 0 when skipped.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "commit_seq_after": {
          "description": "Batches committed after this run. Equal to `commit_seq_before` unless `status` is `loaded`.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "commit_seq_before": {
          "description": "Batches committed before this run.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "egress_hosts": {
          "description": "The hosts the manifest declares. Declared, not enforced.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "description": "Why the run failed. Present only when `status` is `failed`.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The `[connector.<name>]` key.",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ConnectorLoadStatus"
        }
      },
      "required": [
        "adopted_expired_claim",
        "attempts",
        "commit_seq_after",
        "commit_seq_before",
        "egress_hosts",
        "name",
        "status"
      ],
      "type": "object"
    },
    "ConnectorLoadStatus": {
      "description": "How a `rocky load --connector` run ended: `loaded` (the batch is in the target table and the connector state is saved), `skipped` (another run holds the claim for this batch, so nothing ran) or `failed` (see `error`).",
      "enum": [
        "loaded",
        "skipped",
        "failed"
      ],
      "type": "string"
    },
    "ContractResult": {
      "description": "Result of contract validation.",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "violations": {
          "items": {
            "$ref": "#/definitions/ContractViolation"
          },
          "type": "array"
        },
        "warnings": {
          "default": [],
          "description": "Non-fatal warnings — e.g. a contract clause that can't be meaningfully enforced in this context, or a required column whose type Rocky could not compare because the landed or the declared type string is outside its type map. Does not affect `passed`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "passed",
        "violations"
      ],
      "type": "object"
    },
    "ContractViolation": {
      "description": "A single contract rule violation with the rule name, affected column, and message.",
      "properties": {
        "column": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      },
      "required": [
        "column",
        "message",
        "rule"
      ],
      "type": "object"
    },
    "LoadFileOutput": {
      "description": "A single file result within `LoadOutput`.",
      "properties": {
        "bytes_read": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "contract": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContractResult"
            },
            {
              "type": "null"
            }
          ],
          "description": "Result of the data-contract gate, when the load pipeline declares a contract. `None` for ungated loads. On a failed gate the data was not promoted to the target; the violations explain why."
        },
        "duration_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": "string"
        },
        "rows_loaded": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "bytes_read",
        "duration_ms",
        "file",
        "rows_loaded",
        "target"
      ],
      "type": "object"
    }
  },
  "description": "JSON output for `rocky load`.",
  "properties": {
    "command": {
      "type": "string"
    },
    "connector": {
      "anyOf": [
        {
          "$ref": "#/definitions/ConnectorLoadInfo"
        },
        {
          "type": "null"
        }
      ],
      "description": "Set by `rocky load --connector`: what the child connector run did. Absent for a load from a directory."
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/definitions/LoadFileOutput"
      },
      "type": "array"
    },
    "files_failed": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "files_loaded": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "format": {
      "type": "string"
    },
    "source_dir": {
      "type": "string"
    },
    "total_bytes": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "total_rows": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "command",
    "duration_ms",
    "files",
    "files_failed",
    "files_loaded",
    "format",
    "source_dir",
    "total_bytes",
    "total_rows",
    "version"
  ],
  "title": "LoadOutput",
  "type": "object"
}
