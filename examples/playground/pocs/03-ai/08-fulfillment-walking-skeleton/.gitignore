# Generated by run.sh on every invocation — never committed.
products/
wh.duckdb
wh.duckdb.wal
.rocky/
.rocky-state.redb
.rocky-state.redb.lock
models/.rocky-state.redb
models/.rocky-state.redb.lock
models/revenue_daily.sql
models/revenue_daily.toml
models/revenue_daily.contract.toml

# expected/ goldens are regenerated each run (gitignored per the POC skill),
# EXCEPT the live evidence bundle, which is the banked Phase-1 proof. Ignore the
# CONTENTS (expected/*) rather than the directory, so the live/ subdir can be
# re-included (git cannot re-include inside a fully-excluded directory).
/expected/*
!/expected/live/
# The banked worker transcripts are *.log — re-include them past the repo-root
# `*.log` ignore (their parent dir is not excluded, so this negation is honoured).
!/expected/live/transcripts/*.log
