# Copy to .env and fill in. Compose reads .env next to compose.yaml; the file
# is listed in .gitignore, so it never lands in a commit.

# The bearer token every API call carries. The browser UI gets it once,
# in the URL fragment the server prints at start. Generate:
#   openssl rand -hex 32
ROCKY_SERVE_TOKEN=

# Signs the scheduler's webhook ingress (POST /api/v1/hooks/trigger/...).
# Required with --scheduler next to --ui. Generate the same way.
ROCKY_WEBHOOK_SECRET=

# Optional: run a different image, for example one you built yourself.
# ROCKY_IMAGE=rocky:local

# Warehouse credentials your rocky.toml references through ${VAR}.
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
