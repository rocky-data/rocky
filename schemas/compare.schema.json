{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TableCompareResult": {
      "properties": {
        "production_count": {
          "description": "Null when the warehouse count could not be read.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "production_table": {
          "type": "string"
        },
        "reasons": {
          "description": "Read errors for an `error` row, or threshold reasons for `warn`/`fail`. Empty for `pass`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "row_count_diff_pct": {
          "description": "Null unless both counts were read.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "row_count_match": {
          "type": "boolean"
        },
        "schema_diffs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_match": {
          "type": "boolean"
        },
        "shadow_count": {
          "description": "Null when the warehouse count could not be read.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "shadow_table": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        }
      },
      "required": [
        "production_table",
        "reasons",
        "row_count_match",
        "schema_diffs",
        "schema_match",
        "shadow_table",
        "verdict"
      ],
      "type": "object"
    }
  },
  "description": "JSON output for `rocky compare`.",
  "properties": {
    "command": {
      "type": "string"
    },
    "filter": {
      "type": "string"
    },
    "overall_verdict": {
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/definitions/TableCompareResult"
      },
      "type": "array"
    },
    "tables_compared": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "tables_failed": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "tables_passed": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "tables_warned": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "command",
    "filter",
    "overall_verdict",
    "results",
    "tables_compared",
    "tables_failed",
    "tables_passed",
    "tables_warned",
    "version"
  ],
  "title": "CompareOutput",
  "type": "object"
}
