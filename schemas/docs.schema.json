{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Output for `rocky docs --output json`.",
  "properties": {
    "command": {
      "type": "string"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "models_count": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "output_path": {
      "type": "string"
    },
    "pipelines_count": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "command",
    "duration_ms",
    "models_count",
    "output_path",
    "pipelines_count",
    "version"
  ],
  "title": "DocsOutput",
  "type": "object"
}
