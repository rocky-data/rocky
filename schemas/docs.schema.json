{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Output for `rocky docs --output json`.",
  "properties": {
    "command": {
      "type": "string"
    },
    "consumers_count": {
      "description": "Downstream consumers (`consumers/`) the documentation lists.",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "files": {
      "description": "Files written, relative to `output_path` (for `html`, the file name).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "format": {
      "description": "What was written: `site` (a directory), `html` (one file) or `parquet` (a directory of tables).",
      "type": "string"
    },
    "models_count": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "output_path": {
      "type": "string"
    },
    "pipelines_count": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "sources_count": {
      "description": "External tables the models read.",
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "command",
    "consumers_count",
    "duration_ms",
    "files",
    "format",
    "models_count",
    "output_path",
    "pipelines_count",
    "sources_count",
    "version"
  ],
  "title": "DocsOutput",
  "type": "object"
}
